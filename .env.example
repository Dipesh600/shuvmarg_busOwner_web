# ─────────────────────────────────────────────────────────────────────────────
# Shuv Marg Bus Owner (Operator) Portal — Environment Variables
#
# Copy this file to .env.local and fill in values for your environment.
# All NEXT_PUBLIC_* variables are embedded at build time and exposed to the browser.
# Never put secrets (private keys, JWT secrets, etc.) in NEXT_PUBLIC_ vars.
#
# DO NOT COMMIT .env.local — it is listed in .gitignore via .env*.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API base URL — the /api prefix is required; the client appends paths directly.
# Local:      http://localhost:7012/api
# Staging:    https://api-staging.shuvmarg.com/api
# Production: https://api.shuvmarg.com/api
NEXT_PUBLIC_API_URL=

# App domain (used for metadata, canonical links, etc.)
NEXT_PUBLIC_APP_DOMAIN=shuvmarg.com

# Contact information displayed in the UI (safe to be public)
NEXT_PUBLIC_SUPPORT_EMAIL=support@shuvmarg.com
NEXT_PUBLIC_PARTNER_EMAIL=partners@shuvmarg.com
NEXT_PUBLIC_AGENT_EMAIL=agent@shuvmarg.com
NEXT_PUBLIC_VENDOR_EMAIL=station-manager@shuvmarg.com
NEXT_PUBLIC_SUPPORT_PHONE=
